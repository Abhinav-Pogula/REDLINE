{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/conflicts/[id]",
      "regex": "^/conflicts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/conflicts/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/decisions/[id]",
      "regex": "^/decisions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/decisions/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/evidence/[id]",
      "regex": "^/evidence/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/evidence/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/meetings/[id]",
      "regex": "^/meetings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/meetings/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/commitments",
      "regex": "^/commitments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/commitments(?:/)?$"
    },
    {
      "page": "/conflicts",
      "regex": "^/conflicts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/conflicts(?:/)?$"
    },
    {
      "page": "/decisions",
      "regex": "^/decisions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/decisions(?:/)?$"
    },
    {
      "page": "/demo",
      "regex": "^/demo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo(?:/)?$"
    },
    {
      "page": "/evidence",
      "regex": "^/evidence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/evidence(?:/)?$"
    },
    {
      "page": "/record",
      "regex": "^/record(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/record(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}